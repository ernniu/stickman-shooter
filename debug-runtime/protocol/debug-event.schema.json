{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Debug Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "timestamp_ms", "data"],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^debug\\.[a-z0-9_.-]+$"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    }
  }
}
